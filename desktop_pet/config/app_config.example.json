{
  "app": {
    "name": "Desktop AI Pet",
    "character_name": "小桃",
    "version": "2.0"
  },
  "api": {
    "provider": "deepseek",
    "enable_chat_api": true,
    "deepseek": {
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-flash",
      "api_key": "",
      "timeout_seconds": 30
    },
    "openai": {
      "name": "OpenAI",
      "base_url": "https://api.openai.com/v1",
      "wire_api": "responses",
      "requires_openai_auth": true,
      "model": "gpt-5.6-luna",
      "api_key": "",
      "api_key_env": "OPENAI_API_KEY",
      "timeout_seconds": 30
    },
    "max_recent_messages": 20,
    "summary_trigger_rounds": 40,
    "max_prompt_chars": 12000,
    "max_history_messages": 12,
    "max_user_message_chars": 1200,
    "max_history_message_chars": 600,
    "max_summary_chars": 1200,
    "max_memory_chars": 1200,
    "summary_max_input_chars": 5000
  },
  "ui": {
    "always_on_top": true,
    "scale": 0.6,
    "enable_free_move": true,
    "click_to_chat": true,
    "start_position": "bottom_right",
    "remember_last_position": true,
    "bubble_durations_ms": {
      "startup_greeting": 7000,
      "period_greeting": 7000,
      "proactive_greeting": 6000,
      "assistant_reply": 15000
    },
    "show_test_menu": false,
    "show_clear_menu": false,
    "show_chat_api_menu": false,
    "show_reload_config": false
  },
  "behavior": {
    "do_not_disturb": false,
    "proactive_chat": true,
    "startup_greeting": true,
    "min_proactive_interval_minutes": 20,
    "night_greeting": {
      "enabled": true,
      "min_interval_minutes": 10
    },
    "max_consecutive_active_replies": 5,
    "enable_scenario_greeting": true,
    "scenario_greeting_api_enabled": true,
    "scenario_greeting_max_chars": 80,
    "scenario_greeting_min_memory_items": 1,
    "scenario_greeting_cooldown_minutes": 60,
    "scenario_greeting_low_interrupt_after_ignored": 2
  },
  "reminders": {
    "enabled": true,
    "check_interval_seconds": 30,
    "max_active_reminders": 20,
    "respect_do_not_disturb": false,
    "auto_cleanup_enabled": true,
    "completed_retention_days": 7,
    "ack_repeat_minutes": 5,
    "snooze_minutes": 10
  },
  "clipboard": {
    "enabled": true,
    "max_chars": 4000
  },
  "screenshot": {
    "enabled": true,
    "capture_delay_ms": 180,
    "max_image_edge": 2048,
    "max_image_bytes": 6291456,
    "detail": "auto",
    "max_output_tokens": 80,
    "selection_min_size": 12,
    "question_max_chars": 500
  },
  "local_lines_refresh": {
    "enabled": true,
    "interval_days": 14,
    "monthly_refresh": false,
    "max_items": 8,
    "max_chars": 80,
    "greeting_types": {
      "time": {
        "enabled": false
      },
      "arrival": {
        "enabled": true
      },
      "care": {
        "enabled": true
      },
      "scenario": {
        "enabled": true
      },
      "interaction": {
        "enabled": true
      }
    }
  },
  "chat": {
    "formal_qa_mode": false,
    "formal_answer_display": "new_panel",
    "force_summarize_before_clear": true
  },
  "proactive_content_ratio": {
    "extra_knowledge": 0.35,
    "regular_greeting": 0.65
  }
}
